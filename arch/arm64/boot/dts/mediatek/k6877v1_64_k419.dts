/* keypad end */

&ps5169{
	pinctrl-names = "enable", "disable";
	pinctrl-0 = <&ps_enable>;
	pinctrl-1 = <&ps_disable>;
	status = "okay";
};

&fusb340 {
	pinctrl-names = "sel_up", "sel_down";
	pinctrl-0 = <&sel_up>;
	pinctrl-1 = <&sel_down>;
	status = "okay";
};

&pio {
	ps_enable: ps_enable {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO121__FUNC_GPIO121>;
			output-high;
		};
	};

	ps_disable: ps_disable {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO121__FUNC_GPIO121>;
			output-low;
		};
	};

	sel_up: sel_up {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO6__FUNC_GPIO6>;
			output-high;
		};
	};

	sel_down: sel_down {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO6__FUNC_GPIO6>;
			output-low;
		};
	};
};

&i2c0 {
        lcd@ocp2131 {
                   compatible = "mediatek,I2C_LCD_BIAS";
                   reg = <0x3e>;
                   status = "okay";
        };
};

&i2c3 {
	status = "okay";
	
	/* pn544@28{
		status = "okay";
		compatible = "nxp,pn544";
		reg = <0x28>;
		nxp,pn544-irq = <&pio 11 0x00>;
		nxp,pn544-ven = <&pio 10 0x00>;
		nxp,pn544-fw-dwnld = <&pio 7 0x00>;
	}; */

	tms_nfc: tms_nfc@28 {
	status = "okay";
	compatible = "tms,nfc";
	reg = <0x28>;
	tms,device-name = "tms_nfc";
	tms,device-count = <1>;
	tms,irq-gpio = <&pio 11 0x00>; //GPIO1_A0
	tms,ven-gpio = <&pio 10 0x00>; //GPIO1_A1
	tms,download-gpio = <&pio 7 0x00>; //GPIO1_A3
	};
};

&spi0 {
    focaltech@0 {
        compatible = "focaltech,fts";
        reg = <0x0>;
        spi-max-frequency = <6000000>;
        vdd-supply = <&mt_pmic_vtp_ldo_reg>;
        interrupt-parent = <&pio>;
        interrupts = <14 IRQ_TYPE_EDGE_FALLING 14 0>;
        focaltech,reset-gpio = <&pio 15 0>;
        focaltech,irq-gpio = <&pio 14 02>;
        focaltech,max-touch-number = <10>;
        focaltech,display-coords =  <0 0 720 1600>;
        status = "okay";
    };
};

