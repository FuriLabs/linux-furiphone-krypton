&custom_keys {
	interrupt-parent = <&pio>;
	status = "okay";
	key0 {
	    label = "cam_switch";
	    gpios = <&pio 21 GPIO_ACTIVE_HIGH>;
	    linux,code = <KEY_CAMERA>;
	    wakeup-source;
	    debounce-interval = <50>;
	};
	key1 {
	    label = "nwk_switch";
	    gpios = <&pio 22 GPIO_ACTIVE_HIGH>;
	    linux,code = <60>;
	    wakeup-source;
	    debounce-interval = <50>;
	};
};

